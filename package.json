{
  "name": "aura-license-management-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Aura Life Sciences License & Subscription Management Platform (FastAPI + React)",
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
