# ========================================================
# Aura License & Subscription Management - Production Config
# ========================================================

# PostgreSQL Connection (Default localhost:5433 or Docker: db:5432)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/auralicense
POSTGRES_PASSWORD=postgres

# JWT Security
JWT_SECRET=aura_lifesciences_super_secure_jwt_secret_key_2026_gxp_part11
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Asymmetric Cryptography (Ed25519)
# Optional: Pre-generate a 32-byte Base64 Ed25519 private key.
# If left blank, Aura will deterministically generate and maintain keypairs.
ED25519_PRIVATE_KEY_B64=
ED25519_PUBLIC_KEY_B64=

# GxP Regulatory Compliance & Audit Chaining
ENABLE_GXP_HASH_CHAIN=true

# Server Networking
PORT=8090
FRONTEND_PORT=3000
